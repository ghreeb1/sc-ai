{
  "name": "scholar-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "cross-env EXPO_OFFLINE=1 expo start",
    "android": "cross-env EXPO_OFFLINE=1 expo start --android",
    "ios": "cross-env EXPO_OFFLINE=1 expo start --ios",
    "web": "cross-env EXPO_OFFLINE=1 expo start --web",
    "build": "eas build",
    "build:ios": "eas build --platform ios",
    "build:android": "eas build --platform android",
    "preview": "eas build --local",
    "eject": "expo prebuild",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-picker/picker": "^2.11.1",
    "ajv": "^8.14.0",
    "ajv-keywords": "^5.1.0",
    "date-fns": "^3.0.0",
    "expo": "~54.0.0",
    "expo-font": "~14.0.12",
    "expo-linking": "^56.0.13",
    "expo-localization": "~17.0.9",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "i18next": "^23.7.0",
    "lucide-react-native": "^0.408.0",
    "nativewind": "^4.1.2",
    "react": "^19.1.0",
    "react-native": "^0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.12.1",
    "react-native-worklets": "^0.5.1",
    "uuid": "^9.0.1",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "~19.1.10",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prettier": "^3.0.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.8.3"
  }
}
